# pawmigo backend — environment config template
#
# 用法：复制本文件为同目录下的 .env，填入真实值。
#   cp backend/api/.env.example backend/api/.env
# 真实 .env 已被 .gitignore 忽略，切勿提交（尤其 WECHAT_APP_SECRET / JWT 密钥）。
#
# 下面分两组：
#   [ACTIVE]  = 后端当前就会读取、立即生效
#   [PLANNED] = 即将接入的阶段（微信登录 / 上传 / Redis / 地图）预留，目前代码尚未读取
#
# 注：需要 .env 自动生效要等「.env 加载器」接入；在此之前可手动
#   set -a; source backend/api/.env; set +a   再启动服务。

# ============ [ACTIVE] 存储与鉴权（现在就生效） ============

# 存储后端：memory（默认） | gorm
PAWMIGO_STORE=gorm

# MySQL DSN（PAWMIGO_STORE=gorm 且想用 MySQL 时填）。留空则用 sqlite。
# 本机示例（root 有密码时填密码；utf8mb4 + parseTime 必带）：
MYSQL_DSN=root:你的密码@tcp(127.0.0.1:3306)/pawmigo?charset=utf8mb4&parseTime=true&loc=Local

# sqlite 文件路径（仅当 MYSQL_DSN 为空时使用）
PAWMIGO_DB_PATH=pawmigo.db

# 是否灌开发种子数据：sqlite 默认会灌；使用 MySQL 时默认不灌，设 1/true 才灌
PAWMIGO_SEED=0

# JWT 签名密钥 —— 生产必须改成足够长的随机串（开发留空会用内置 dev 默认值）
PAWMIGO_JWT_SECRET=change_me_to_a_long_random_string

# ============ [PLANNED] 微信登录（下一步要接：code2session） ============
# 在微信公众平台 -> 小程序 -> 开发管理 获取
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# ============ [PLANNED] 服务端口（当前固定 8080，接入后可配） ============
APP_PORT=8080

# ============ [PLANNED] 图片上传 腾讯云 COS（后续阶段） ============
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-shanghai

# ============ [PLANNED] Redis（后续阶段） ============
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# ============ [PLANNED] 腾讯地图（后续阶段） ============
TENCENT_MAP_KEY=
